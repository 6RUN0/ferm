add table ip ferm
delete table ip ferm
add table ip ferm
add chain ip ferm mangle_PREROUTING { type filter hook prerouting priority -150; }
add rule ip ferm mangle_PREROUTING meta mark set meta mark & 0xffffff01 | 0x00000001
add rule ip ferm mangle_PREROUTING meta mark set meta mark | 0x000000ff
add rule ip ferm mangle_PREROUTING meta mark set meta mark | 0x00000004
add rule ip ferm mangle_PREROUTING meta mark set meta mark & 0x000000f0
add rule ip ferm mangle_PREROUTING meta mark set meta mark ^ 0x00000008
add rule ip ferm mangle_PREROUTING ct mark set ct mark & 0xffffff02 | 0x00000002
add rule ip ferm mangle_PREROUTING ct mark set ct mark | 0x00000010
add rule ip ferm mangle_PREROUTING ct mark set ct mark & 0x000000f0
add rule ip ferm mangle_PREROUTING ct mark set ct mark ^ 0x00000008
