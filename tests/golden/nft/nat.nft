add table ip ferm
delete table ip ferm
add table ip ferm
add chain ip ferm nat_POSTROUTING { type nat hook postrouting priority 100; }
add chain ip ferm nat_PREROUTING { type nat hook prerouting priority -100; }
add rule ip ferm nat_POSTROUTING oifname "eth0" snat to 192.168.1.1
add rule ip ferm nat_POSTROUTING oifname "ppp0" masquerade
add rule ip ferm nat_POSTROUTING oifname "eth1" snat to 192.168.1.2 random
add rule ip ferm nat_POSTROUTING oifname "eth2" masquerade random
add rule ip ferm nat_POSTROUTING oifname "eth3" masquerade fully-random
add rule ip ferm nat_POSTROUTING oifname "eth4" masquerade random,fully-random
add rule ip ferm nat_PREROUTING tcp dport 80 dnat to 10.0.0.1
add rule ip ferm nat_PREROUTING tcp dport 443 dnat to 10.0.0.2 random,persistent
add rule ip ferm nat_PREROUTING tcp dport 8080 redirect to :8081 random
