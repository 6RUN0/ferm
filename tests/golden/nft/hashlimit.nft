add table ip ferm
delete table ip ferm
add table ip ferm
add set ip ferm hashlimit_flood { type ipv4_addr . inet_service; size 65535; flags dynamic; }
add set ip ferm hashlimit_ssh_brute { type ipv4_addr; size 65535; flags dynamic,timeout; }
add chain ip ferm INPUT { type filter hook input priority 0; }
add rule ip ferm INPUT meta l4proto tcp update @hashlimit_ssh_brute { ip saddr timeout 1m limit rate 3/minute burst 5 packets } accept
add rule ip ferm INPUT update @hashlimit_flood { ip saddr & 255.255.255.0 . tcp dport limit rate over 10/second burst 5 packets } drop
